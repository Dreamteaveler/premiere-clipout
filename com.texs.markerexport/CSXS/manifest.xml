<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.texs.markerexport"
                   ExtensionBundleVersion="1.1.10"
                   ExtensionBundleName="Premiere ClipOut · 剪辑批量导出"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.texs.markerexport.panel" Version="1.1.10"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- PPRO = Premiere Pro. 2021 uses 15.x; host range permits testing, not a compatibility guarantee. -->
            <Host Name="PPRO" Version="[8.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="5.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.texs.markerexport.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./host/export-markers.jsx</ScriptPath>
                    <CEFCommandLine><Parameter>--enable-nodejs</Parameter></CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Premiere ClipOut · 剪辑批量导出</Menu>
                    <Geometry>
                        <Size>
                            <Height>440</Height>
                            <Width>340</Width>
                        </Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
